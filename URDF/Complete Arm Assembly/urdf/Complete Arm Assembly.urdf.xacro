  </link>

  <!-- ════════════════════════════════════════════
       JOINTS
  ════════════════════════════════════════════ -->

  <joint name="joint_1" type="revolute">
    <origin xyz="0.69033 -1.3112 0.92243" rpy="1.5708 0 0" />
    <parent link="base_link" />
    <child  link="link_1" />
    <axis xyz="0 1 0" />
    <limit lower="-3.14159" upper="3.14159" effort="1.0" velocity="1.0" />
  </joint>

  <joint name="joint_2" type="revolute">
    <origin xyz="0 -0.041995 0" rpy="0 0 0" />
    <parent link="link_1" />
    <child  link="link_2" />
    <axis xyz="0 1 0" />
    <limit lower="-1.5708" upper="1.5708" effort="1.0" velocity="1.0" />
  </joint>

  <joint name="joint_3" type="revolute">
    <origin xyz="-0.0585 0.2105 0" rpy="3.1416 0 1.5708" />
    <parent link="link_2" />
    <child  link="link_3" />
    <axis xyz="0 1 0" />
    <limit lower="-1.5708" upper="1.5708" effort="1.0" velocity="1.0" />
  </joint>

  <joint name="joint_4" type="revolute">
    <origin xyz="-0.2105 0.0585 0" rpy="3.1416 0 1.5708" />
    <parent link="link_3" />
    <child  link="link_4" />
    <axis xyz="0 1 0" />
    <limit lower="-1.5708" upper="1.5708" effort="1.0" velocity="1.0" />
  </joint>

  <joint name="wrist_rotate_joint" type="revolute">
    <origin xyz="0.2223 0.24575 0.0005" rpy="0 1.5708 0" />
    <parent link="link_4" />
    <child  link="end_effector" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14159" upper="3.14159" effort="1.0" velocity="1.0" />
  </joint>

  <!-- right_finger_joint
       xyz: R_ee_inv @ (r_hinge_asm - ee_origin_asm)
            = [[0,1,0],[0,0,1],[1,0,0]] @ ([0.2065,0.2105,0.028614] - [0.9126,-1.3117,1.1262])
            = [[0,1,0],[0,0,1],[1,0,0]] @ [-0.7061, 1.5222, -1.0976]
            = [1.5222, -1.0976, -0.7061]
       rpy: (-pi/2, -pi/2, 0) gives R_joint = R_ee_inv ✓
       axis: assembly Z in finger link frame = R_ee_inv @ [0,0,1] = [0,1,0]
             fingers open/close in the ±Y direction of the link frame -->
  <joint name="right_finger_joint" type="revolute">
    <origin xyz="1.5222 -1.0976 -0.7061" rpy="-1.5708 -1.5708 0" />
    <parent link="end_effector" />
    <child  link="right_finger" />
    <axis xyz="0 1 0" />
    <limit lower="0.0" upper="0.019" effort="0.5" velocity="0.5" />
  </joint>

  <!-- left_finger_joint
       xyz: R_ee_inv @ (l_hinge_asm - ee_origin_asm)
            = [[0,1,0],[0,0,1],[1,0,0]] @ [-0.7061, 1.5222, -1.1548]
            = [1.5222, -1.1548, -0.7061]
       Mimics right_finger_joint with multiplier=-1 (symmetric opening). -->
  <joint name="left_finger_joint" type="revolute">
    <origin xyz="1.5222 -1.1548 -0.7061" rpy="-1.5708 -1.5708 0" />
    <parent link="end_effector" />
    <child  link="left_finger" />
    <axis xyz="0 1 0" />
    <limit lower="0.0" upper="0.019" effort="0.5" velocity="0.5" />
    <mimic joint="right_finger_joint" multiplier="-1" offset="0" />
  </joint>

</robot>
