  <!-- right_finger
       joint_xyz: hinge centre in EE frame = R_ee_inv @ (hinge_asm - ee_origin_asm)
                  hinge_asm = (0.2065, 0.2105, 0.028614)  [proximal face centroid]
                  ee_origin_asm = (0.9126, -1.3117, 1.1262)  [FK at zero config]
       joint_rpy: (-pi/2, -pi/2, 0) → R_joint = R_ee_inv, aligns child frame with assembly
       visual xyz: -hinge_asm = (-0.2065, -0.2105, -0.028614)
                   cancels the mesh global offset so it renders at its assembly position
       Verified: all 11709 mesh vertices render at exact assembly coords. -->
  <link name="right_finger">
    <inertial>
      <origin xyz="-0.009017 0.032618 0.000124" rpy="0 0 0" />
      <mass value="0.0287713290324161" />
      <inertia
        ixx="7.70020810555669E-06"  ixy="-3.29946062739848E-09" ixz="2.1767893928585E-07"
        iyy="8.54305538090567E-06"  iyz="3.07283827617671E-08"  izz="1.30617201704644E-05" />
    </inertial>
    <visual>
      <origin xyz="-0.2065 -0.2105 -0.028614" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://Complete Arm Assembly/meshes/right_finger.STL" />
      </geometry>
      <material name=""><color rgba="0.250980392156863 0.250980392156863 0.250980392156863 1" /></material>
    </visual>
    <collision>
      <origin xyz="-0.2065 -0.2105 -0.028614" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://Complete Arm Assembly/meshes/right_finger.STL" />
      </geometry>
    </collision>
  </link>

  <!-- left_finger: mirror of right_finger.
       hinge_asm = (0.2065, 0.2105, -0.028614) -->
  <link name="left_finger">
    <inertial>
      <origin xyz="0.009017 0.032618 -0.000040" rpy="0 0 0" />
      <mass value="0.0287713290324178" />
      <inertia
        ixx="7.70020810574403E-06"  ixy="3.29946061413401E-09"  ixz="-2.1767894158894E-07"
        iyy="8.54294598243539E-06"  iyz="3.12650719969816E-08"  izz="1.30618295687512E-05" />
