<?xml version="1.0" encoding="utf-8"?>
<!-- Cleaned and repaired by Claude from SolidWorks URDF export.
     Original created by SolidWorks to URDF Exporter (Stephen Brawner).

     FIXES APPLIED
     ─────────────────────────────────────────────────────────────────
     1. Duplicate joint names: three joints all named "joint_5" renamed
        to wrist_rotate_joint, right_finger_joint, left_finger_joint.

     2. Zero-vector axes:
          joint_2, joint_3, joint_4 → axis="0 1 0"
          wrist_rotate_joint        → axis="0 0 1"
          finger joints             → axis="0 1 0" (assembly Z in link frame)

     3. Zero limits → physically meaningful ranges.

     4. Mimic self-reference fixed: left_finger_joint now mimics
        right_finger_joint with multiplier="-1".

     5. FINGER JOINT ORIGINS — root cause of invisible/floating fingers.
        The exported joint xyz values were in a SolidWorks sub-assembly
        mating frame unrelated to the end_effector URDF frame.
        Method: full forward-kinematics to compute end_effector world
        transform, then express each finger hinge (proximal STL face
        centroid) in end_effector local frame via R_ee_inv @ (hinge - ee_origin).
          right_finger_joint xyz:  1.522197  -1.097577  -0.706130
          left_finger_joint  xyz:  1.522197  -1.154804  -0.706130
        joint rpy for both: -1.5708  -1.5708  0
        (rpy gives R_joint = R_ee_inv so child frame aligns with assembly frame)

     6. FINGER VISUAL/COLLISION ORIGINS added.
        All STL meshes in this file are stored in SolidWorks assembly
        global coordinates. Every other link renders correctly because
        its joint origin coincidentally cancels the mesh global offset.
        For the fingers the joint origin is at the hinge (for correct
        articulation), so a visual xyz offset is required to cancel the
        remaining mesh global offset:
          right_finger visual xyz: -0.206500  -0.210500  -0.028614
          left_finger  visual xyz: -0.206500  -0.210500   0.028614
        Numerically verified: every mesh vertex renders at its exact
        assembly-frame position after the full transform chain.

     7. FINGER INERTIAL CoM corrected from assembly global frame to
        finger child frame (computed from FK and STL data):
          right_finger: -0.009017   0.032618   0.000124
          left_finger:   0.009017   0.032618  -0.000040
-->
<robot name="Complete_Arm_Assembly">

  <!-- ════════════════════════════════════════════
       LINKS
  ════════════════════════════════════════════ -->

  <link name="base_link">
    <inertial>
      <origin xyz="0.678429842319806 0.89260990231199 1.31112689300818" rpy="0 0 0" />
      <mass value="0.0944596926666318" />
      <inertia
        ixx="2.49395953752312E-05"  ixy="-1.12263643586799E-07" ixz="1.05007095359662E-09"
        iyy="4.59171615103605E-05"  iyz="-8.45504983950467E-09" izz="3.13098714846083E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://Complete Arm Assembly/meshes/base_link.STL" />
      </geometry>
      <material name=""><color rgba="0.894117647058823 0.894117647058823 0.894117647058823 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://Complete Arm Assembly/meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>

