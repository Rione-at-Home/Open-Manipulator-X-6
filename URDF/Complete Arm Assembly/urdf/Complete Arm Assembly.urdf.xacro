      <mass value="0.0448261455614491" />
      <inertia
        ixx="1.48346334805848E-05"  ixy="1.04956819868227E-07"  ixz="-4.142452998686E-09"
        iyy="1.38058356627431E-05"  iyz="6.81252259255115E-07"  izz="2.3557490611066E-05" />
