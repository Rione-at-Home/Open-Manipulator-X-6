  <!-- wrist_cam: optical frame of the Elecom wrist camera (z out of the lens, x right in the image,
       y down), the frame_id its images use. PLACEHOLDER pose; the hand-eye calibration will give
       the real one. Mass not included (add it to gripper_base_link once weighed). -->
  <link
    name="wrist_cam" />
