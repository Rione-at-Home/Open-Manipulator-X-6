<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="complete_arm_assembly">

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.5" />
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/ri-one/Open-Manipulator-X-6/complete_arm_assembly/meshes/base_link.STL" />
      </geometry>
      <material name=""><color rgba="0.894 0.894 0.894 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/ri-one/Open-Manipulator-X-6/complete_arm_assembly/meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>

  <link name="link_1">
    <inertial>
      <origin xyz="0 0.027 0" rpy="0 0 0" />
      <mass value="0.3" />
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/ri-one/Open-Manipulator-X-6/complete_arm_assembly/meshes/link_1.STL" />
      </geometry>
      <material name=""><color rgba="0.894 0.894 0.894 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/ri-one/Open-Manipulator-X-6/complete_arm_assembly/meshes/link_1.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="joint_1" type="revolute">
    <origin xyz="-0.00078087 -1.0373 0.041025" rpy="1.5708 0 0.52968" />
    <parent link="base_link" />
    <child link="link_1" />
    <axis xyz="0 1 0" />
    <limit lower="-3.14" upper="3.14" effort="15" velocity="1" />
    <dynamics damping="0.2" friction="0.1"/>
  </joint>

  <link name="link_2">
    <inertial>
      <origin xyz="0 0.104 0" rpy="0 0 0" />
      <mass value="0.3" />
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/ri-one/Open-Manipulator-X-6/complete_arm_assembly/meshes/link_2.STL" />
      </geometry>
      <material name=""><color rgba="0.894 0.894 0.894 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/ri-one/Open-Manipulator-X-6/complete_arm_assembly/meshes/link_2.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="joint_2" type="revolute">
    <origin xyz="0 0.040505 0" rpy="0 0 0.75692" />
    <parent link="link_1" />
    <child link="link_2" />
    <axis xyz="0 0 1" />
    <limit lower="-1.57" upper="1.57" effort="15" velocity="1" />
    <dynamics damping="0.2" friction="0.1"/>
  </joint>

  <link name="link_3">
    <inertial>
      <origin xyz="0.093 0 0" rpy="0 0 0" />
      <mass value="0.3" />
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/ri-one/Open-Manipulator-X-6/complete_arm_assembly/meshes/link_3.STL" />
      </geometry>
      <material name=""><color rgba="0.894 0.894 0.894 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/ri-one/Open-Manipulator-X-6/complete_arm_assembly/meshes/link_3.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="joint_3" type="revolute">
    <origin xyz="0.024 0.128 0" rpy="0 0 0.23095" />
    <parent link="link_2" />
    <child link="link_3" />
    <axis xyz="0 0 1" />
    <limit lower="-1.57" upper="1.57" effort="15" velocity="1" />
    <dynamics damping="0.2" friction="0.1"/>
  </joint>

  <link name="link_4">
    <inertial>
      <origin xyz="0.05 0.01 0" rpy="0 0 0" />
      <mass value="0.4" />
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/ri-one/Open-Manipulator-X-6/complete_arm_assembly/meshes/link_4.STL" />
      </geometry>
      <material name=""><color rgba="0.894 0.894 0.894 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/ri-one/Open-Manipulator-X-6/complete_arm_assembly/meshes/link_4.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="joint_4" type="revolute">
    <origin xyz="0.124 0 0" rpy="0 0 -0.98787" />
    <parent link="link_3" />
    <child link="link_4" />
    <axis xyz="0 0 1" />
    <limit lower="-1" upper="2." effort="15" velocity="1" />
    <dynamics damping="0.2" friction="0.1"/>
  </joint>

  <link name="link_5">
    <inertial>
      <origin xyz="0.015 -0.002 0" rpy="0 0 0" />
      <mass value="0.2" />
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/ri-one/Open-Manipulator-X-6/complete_arm_assembly/meshes/link_5.STL" />
      </geometry>
      <material name=""><color rgba="0.894 0.894 0.894 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/ri-one/Open-Manipulator-X-6/complete_arm_assembly/meshes/link_5.STL" />
      </geometry>
    </collision>
  </link>

  <!-- joint_5 damping increased to stabilize wrist carrying finger loads -->
  <joint name="joint_5" type="revolute">
    <origin xyz="0.086402 0.02425 0.0005" rpy="0.036324 0 0" />
    <parent link="link_4" />
    <child link="link_5" />
    <axis xyz="1 0 0" />
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1" />
    <dynamics damping="1.0" friction="0.5"/>
  </joint>

  <link name="left_finger">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.05" />
      <!-- Parallel axis theorem: joint origin is ~1.63m in Y, ~1.79m in Z from link_5
           ixx = 0.0001 + 0.05*(1.6285^2 + 1.7856^2) = 0.292
           iyy = 0.0001 + 0.05*(0.019^2  + 1.7856^2) = 0.159
           izz = 0.0001 + 0.05*(0.019^2  + 1.6285^2) = 0.133 -->
      <inertia ixx="0.292" ixy="0" ixz="0"
                           iyy="0.159" iyz="0"
                                       izz="0.133" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/ri-one/Open-Manipulator-X-6/complete_arm_assembly/meshes/left_finger.STL" />
      </geometry>
      <material name=""><color rgba="0.894 0.894 0.894 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/ri-one/Open-Manipulator-X-6/complete_arm_assembly/meshes/left_finger.STL" />
      </geometry>
    </collision>
  </link>

  <!-- Finger joint damping massively increased to suppress oscillation from large lever arm -->
  <joint name="left_finger_joint" type="prismatic">
    <origin xyz="-0.019263 -1.6285 -1.7856" rpy="0 0 0" />
    <parent link="link_5" />
    <child link="left_finger" />
    <axis xyz="0 0 1" />
    <limit lower="0" upper="0.019" effort="5" velocity="0.1" />
    <dynamics damping="50.0" friction="5.0"/>
  </joint>

  <link name="right_finger">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.05" />
      <!-- Parallel axis theorem: joint origin is ~1.61m in Y, ~1.79m in Z from link_5
           ixx = 0.0001 + 0.05*(1.6058^2 + 1.7856^2) = 0.288
           iyy = 0.0001 + 0.05*(0.019^2  + 1.7856^2) = 0.159
           izz = 0.0001 + 0.05*(0.019^2  + 1.6058^2) = 0.129 -->
      <inertia ixx="0.288" ixy="0" ixz="0"
                           iyy="0.159" iyz="0"
                                       izz="0.129" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/ri-one/Open-Manipulator-X-6/complete_arm_assembly/meshes/right_finger.STL" />
      </geometry>
      <material name=""><color rgba="0.894 0.894 0.894 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/ri-one/Open-Manipulator-X-6/complete_arm_assembly/meshes/right_finger.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="right_finger_joint" type="prismatic">
    <origin xyz="-0.019263 1.6058 1.7856" rpy="-3.1416 0 0" />
    <parent link="link_5" />
    <child link="right_finger" />
    <axis xyz="0 0 -1" />
    <limit lower="-0.019" upper="0.0" effort="5" velocity="0.1" />
    <dynamics damping="50.0" friction="5.0"/>

  </joint>

  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="joint_1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_3">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_4">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_5">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_finger_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_finger_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <link name="world"/>
  <joint name="world_to_base_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <gazebo reference="left_finger">
    <self_collide>false</self_collide>
  </gazebo>
  <gazebo reference="right_finger">
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <parameters>$(find complete_arm_assembly)/config/arm_controllers.yaml</parameters>
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
    </plugin>

  </gazebo>

</robot>