<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>open_manipulator_x6_description</name>
  <version>1.1.0</version>
  <description>URDF, meshes and RViz display for the modified 6-DOF OpenManipulator-X (X6).</description>
  <maintainer email="gilsocojp@gmail.com">Gilbert Soco</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- live mode runs gripper_joint_bridge from the driver package -->
  <exec_depend>open_manipulator_x6</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
